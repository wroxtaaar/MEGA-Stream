# MEGA account used by the VPS service. Never commit your real .env file.
MEGA_EMAIL=your-mega-email@example.com
MEGA_PASSWORD=replace-with-your-mega-password
# Optional current MEGA 2FA code if required at login.
MEGA_TFA_CODE=

# Optional second MEGA account. Leave both values empty to use one account.
MEGA2_EMAIL=
MEGA2_PASSWORD=
MEGA2_TFA_CODE=

# No app login is required for this experimental public website.

HOST=0.0.0.0
PORT=8080
# Set to 1 only behind a trusted HTTPS reverse proxy.
TRUST_PROXY=0
CATALOG_REFRESH_SECONDS=300
